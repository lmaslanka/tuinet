#!/usr/bin/env bash
# ./run          showcase sample: list, edit dialog, progress dialog
# ./run stress   latency / throughput harness
set -euo pipefail
root="$(cd "$(dirname "$0")" && pwd)"
if [ "${1:-}" = "stress" ]; then
  shift
  exec dotnet run -c Release --project "$root/samples/Tuinet.Samples.Stress" -- "$@"
fi
exec dotnet run -c Release --project "$root/samples/Tuinet.Samples.Showcase" -- "$@"
