{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "metadata": [
    {
      "src": [
        {
          "src": "../src",
          "files": ["Tuinet/Tuinet.csproj", "Tuinet.Testing/Tuinet.Testing.csproj"]
        }
      ],
      "dest": "api",
      "outputFormat": "apiPage",
      "namespaceLayout": "flattened",
      "memberLayout": "samePage"
    }
  ],
  "build": {
    "content": [
      { "files": ["*.md", "toc.yml"] },
      { "files": ["api/**.yml", "api/index.md"] }
    ],
    "resource": [
      { "files": ["images/**"] }
    ],
    "exclude": ["plans/**", "_site/**"],
    "output": "_site",
    "template": ["default", "modern"],
    "globalMetadata": {
      "_appName": "TUI.NET",
      "_appTitle": "TUI.NET",
      "_appFooter": "TUI.NET · Apache-2.0",
      "_enableSearch": true,
      "_gitContribute": {
        "repo": "https://github.com/lmaslanka/tuinet",
        "branch": "main"
      }
    }
  }
}
