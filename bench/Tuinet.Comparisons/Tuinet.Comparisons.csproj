<Project Sdk="Microsoft.NET.Sdk">

  <!-- Tuinet vs Spectre.Console vs Terminal.Gui on one scenario. Not part of CI: it pulls third-party
       packages and its numbers only mean something on one quiet machine. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <Optimize>true</Optimize>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
    <PackageReference Include="Spectre.Console" Version="0.57.2" />
    <PackageReference Include="Terminal.Gui" Version="2.5.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Tuinet\Tuinet.csproj" />
  </ItemGroup>

</Project>
