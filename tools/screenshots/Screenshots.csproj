<Project Sdk="Microsoft.NET.Sdk">

  <!-- Renders apps' cell buffers to PNG for the README images (docs/images). Not a sample; see README.md. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Tuinet.Screenshots</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- Only the font parser comes from a package: glyph outlines go through our own rasterizer and PNG writer, so
       the same input gives the same bytes on every machine (no system fonts, no native code, no SIMD-dependent
       blending). SixLabors.Fonts 2.x: Six Labors Split License, which is Apache-2.0 for open-source use; 3.x and later
       require a license key at build time. -->
  <ItemGroup>
    <PackageReference Include="SixLabors.Fonts" Version="2.1.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Tuinet\Tuinet.csproj" />
    <ProjectReference Include="..\..\samples\Tuinet.Samples.Showcase\Tuinet.Samples.Showcase.csproj" />
    <ProjectReference Include="..\..\samples\Tuinet.Samples.Gallery\Tuinet.Samples.Gallery.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="fonts\*.ttf;fonts\*.otf" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
